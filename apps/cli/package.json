{
  "name": "@reconcil/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Thin CLI agent (Anthropic SDK Tool Runner): demo REPL + eval runs; tools bound in-process.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src test",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx src/main.ts",
    "evals": "tsx src/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@reconcil/core": "workspace:*",
    "@reconcil/db": "workspace:*",
    "@reconcil/evals": "workspace:*",
    "@reconcil/mcp-tools": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
