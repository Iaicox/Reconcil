{
  "name": "@reconcil/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server: stdio entry + minimal Fastify host for streamable HTTP (/mcp, /healthz).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "keygen": "tsx src/keygen.ts",
    "smoke:compose": "tsx src/compose-smoke.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@reconcil/core": "workspace:*",
    "@reconcil/db": "workspace:*",
    "@reconcil/mcp-tools": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "^5.0.0",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
