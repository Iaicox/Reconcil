# Copy to .env and fill in. Inside compose, DATABASE_URL and REDIS_URL are
# derived automatically — the values below matter for local development only.

# Postgres password for the compose stack
POSTGRES_PASSWORD=change-me

# Streamable HTTP port (mcp-server)
PORT=8484

# Single self-host tenant (P10, ADR-012). The stdio server resolves and creates it
# on boot; HTTP bearer keys are minted per tenant with the keygen script, never via
# env (the plaintext is shown once):
#   pnpm --filter @reconcil/mcp-server exec tsx src/keygen.ts self-host
SELF_HOST_TENANT_SLUG=self-host

# Export output directory for the close-pack / PDF tools (self-host). Defaults to
# ./exports (the `exports` compose volume); override for a custom deployment path.
# RECONCIL_EXPORT_DIR=/var/lib/reconcil/exports

# Invoice import directory for recon_import_invoices' `file_path` input (self-host).
# UNSET BY DEFAULT (fail-closed): file_path imports are REJECTED until you point this
# at a mounted directory of trusted CSVs. Reads are confined to it (path traversal and
# symlink escape are rejected) and size-capped by RECONCIL_IMPORT_MAX_BYTES (default 8 MB).
# Inline `content` imports work without this. See docker-compose.yml for the mount.
# RECONCIL_IMPORT_DIR=/app/imports
# RECONCIL_IMPORT_MAX_BYTES=8000000

# Encryption key for integration credentials at rest (P9). Generate with:
#   openssl rand -hex 32
MASTER_KEY=

# Chain data providers (worker only; ADR-009). Never needed in CI — tests
# replay recorded fixtures. Optional: with no key the worker falls back to the
# keyless Blockscout provider (tighter rate limits). One Etherscan v2 key covers
# both chains.
ETHERSCAN_API_KEY=

# Base gas fees come from transaction receipts over JSON-RPC, not from the indexer
# (OP-stack L1 data fee, ADR-005) — so ingesting Base fees REQUIRES a Base RPC
# endpoint. Without it the worker throws "BASE_RPC_URL is required for chain base";
# Ethereum ingestion is unaffected. Any public or private Base RPC URL works.
# BASE_RPC_URL=https://mainnet.base.org

# Price providers (worker only; ADR-007). DefiLlama and ECB are keyless; a
# CoinGecko demo key raises rate limits for the secondary source. Optional.
COINGECKO_API_KEY=

# Eval runner + demo REPL (apps/cli). The Anthropic SDK reads these from the
# environment. ANTHROPIC_API_KEY is required to run `evals`/`repl`;
# ANTHROPIC_BASE_URL optionally routes traffic through a gateway (empty ⇒ the
# SDK default, api.anthropic.com). In CI these live as the ANTHROPIC_API_KEY
# secret and the ANTHROPIC_BASE_URL repo variable (evals-* jobs only).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local development outside compose:
# DATABASE_URL=postgres://postgres:change-me@localhost:5432/reconcil
# REDIS_URL=redis://localhost:6379
